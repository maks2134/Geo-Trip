# ==============================================================================
# AtlasFlow / NomadGlass - Local Deployment Environment Variables
# ==============================================================================

# PostgreSQL with PostGIS
POSTGRES_USER=atlasflow
POSTGRES_PASSWORD=atlasflow_secret
POSTGRES_DB=atlasflow
POSTGRES_PORT=5432
DATABASE_URL=postgres://atlasflow:atlasflow_secret@localhost:5432/atlasflow?sslmode=disable

# MinIO (S3 Compatible Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=atlasflow-media
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_USE_SSL=false

# Redis (Spatial & Session Cache)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Microservices & Web Ports
GATEWAY_PORT=8080
TRIP_CORE_PORT=8081
GEO_PLACES_PORT=8082
WEB_PORT=3000

# Auth & Security
JWT_SECRET=dev_atlasflow_jwt_secret_change_in_production
JWT_EXPIRATION_HOURS=24
